# Baked into the Dockerfile (no configuration needed)
# DISPATCHARR_ENV=aio
# REDIS_HOST=localhost
# CELERY_BROKER_URL=redis://localhost:6379/0
# DISPATCHARR_PORT=9191
# DISPATCHARR_LOG_LEVEL=info
# TZ=UTC

# Advanced overrides — add manually as service variables only if needed:
# DISPATCHARR_LOG_LEVEL=debug|info|warning|error
# DISPATCHARR_SETUP_ALLOWED_IP=<your-public-ip>  # only if first-run admin setup is blocked
# TZ=America/Vancouver
